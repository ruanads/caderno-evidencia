{
  "name": "caderno-evidencias",
  "private": true,
  "version": "0.1.0",
  "description": "Caderno de evidencias de teste: importa test cases do Azure Test Plans, coleta prints por passo e exporta CSV, comentario e .zip. Roda offline no navegador.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "docs:prints": "npm run build && playwright test --project=docs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
